{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["gateway", "secret"],
  "properties": {
    "gateway": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": { "type": "boolean" }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "tenantToken": { "type": "string" }
      }
    },
    "collect": {
      "type": "object",
      "properties": {
        "logs": { "type": "object" },
        "state": { "type": "object" },
        "metrics": { "type": "object" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "redactSecrets": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "namespace": { "type": "string" },
              "resources": { "type": "array", "items": { "type": "string" } },
              "names": { "type": "array", "items": { "type": "string" } },
              "verbs": {
                "type": "array",
                "items": { "type": "string", "enum": ["list", "get"] }
              },
              "label_selector": { "type": "string" },
              "field_selector": { "type": "string" }
            },
            "required": ["resources"]
          }
        }
      }
    }
  }
}
